{
  "expo": {
    "name": "CKai",
    "slug": "ckai-private",
    "version": "0.4.1",
    "scheme": "ckai",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "app.ckai.privateassistant",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "backgroundColor": "#151515"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir les photos et vid\u00e9os \u00e0 analyser dans CKai.",
          "cameraPermission": "Photographier un document ou une sc\u00e8ne pour CKai.",
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ]
    ]
  }
}
