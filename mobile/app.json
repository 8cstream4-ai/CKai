{
  "expo": {
    "name": "CKai",
    "slug": "ckai-private",
    "version": "0.5.0",
    "scheme": "ckai",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "app.ckai.privateassistant",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 96,
          "backgroundColor": "#151515"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir les photos et vidéos à analyser dans CKai.",
          "cameraPermission": "Photographier un document ou une scène pour CKai.",
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ]
    ]
  }
}
