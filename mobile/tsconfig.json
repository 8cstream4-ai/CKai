{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "../src/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
